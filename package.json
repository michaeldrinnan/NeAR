{
  "name": "near-web",
  "private": true,
  "version": "2.0.0",
  "description": "Newcastle Audio Ranking test (NeAR) as an offline-capable web app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
